# 환경변수가 .env보다 우선합니다. 이 파일에는 실제 키를 넣지 마세요.
# 비밀값은 NAME 또는 NAME_FILE=/path/to/mounted-secret 형식으로 주입할 수 있습니다.
BACKEND_PORT=5011
FRONTEND_PORT=3011
OUTPUT_LANGUAGE=ko
LOG_LEVEL=INFO

AI_PROVIDER_FORMAT=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# 이미지 생성은 텍스트 모델과 다른 배포가 필요합니다.
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_CAPTION_DEPLOYMENT=
TEXT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-1
IMAGE_CAPTION_MODEL=gpt-5.5

# 역할별 제공자: azure / openai / gemini / vertex / anthropic(텍스트만)
# 비어 있으면 기본 제공자를 따릅니다.
TEXT_MODEL_SOURCE=
IMAGE_MODEL_SOURCE=
IMAGE_CAPTION_MODEL_SOURCE=
TEXT_API_KEY=
TEXT_API_BASE=
IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_CAPTION_API_KEY=
IMAGE_CAPTION_API_BASE=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
GOOGLE_API_KEY=
GOOGLE_API_BASE=https://generativelanguage.googleapis.com
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
OPENAI_IMAGE_API_PROTOCOL=auto
IMAGE_QUALITY=auto
TEXT_MAX_OUTPUT_TOKENS=16384
MAX_DESCRIPTION_WORKERS=3
MAX_IMAGE_WORKERS=3

# 업로드한 문서는 기본적으로 로컬에서 파싱합니다.
# http: POST multipart file -> {"markdown":"..."} 사내 서비스
# mineru: 명시적으로 설정한 MinerU v4 호환 서비스만 사용
DOCUMENT_PARSER=local
DOCUMENT_PARSER_URL=
DOCUMENT_PARSER_TOKEN=
MINERU_API_BASE=
MINERU_TOKEN=
AUTO_IMAGE_CAPTION=false

# 편집형 PPTX: local(Tesseract) 또는 http(사내 OCR)
OCR_PROVIDER=local
OCR_API_URL=
OCR_API_KEY=
OCR_LANGUAGES=kor+eng
# Windows 예: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
INPAINTING_PROVIDER=local

# 사내 HTTPS 인증서 및 프록시. 검증을 끄는 옵션은 제공하지 않습니다.
# CORPORATE_CA_FILE=C:/certs/company-root-ca.pem
# HTTPS_PROXY=http://proxy.company:8080
# HTTP_PROXY=http://proxy.company:8080
NO_PROXY=localhost,127.0.0.1,::1

# 동영상 음성 합성은 외부 전송이 있으므로 명시적 활성화 필요.
TTS_ENABLED=false
ELEVENLABS_API_KEY=
FFMPEG_PATH=ffmpeg

# 편집 가능한 PPTX의 글자 색 추정: local (기본) / caption (비전 모델 호출)
TEXT_STYLE_PROVIDER=local
