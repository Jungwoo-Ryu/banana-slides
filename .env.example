# 환경변수가 .env보다 우선합니다. 비밀값은 NAME_FILE=/mounted/secret으로도 지정할 수 있습니다.
BACKEND_PORT=5011
FRONTEND_PORT=3011
OUTPUT_LANGUAGE=ko
LOG_LEVEL=INFO

# 사내 Azure Foundry OpenAI만 사용합니다. 공개 OpenAI/다른 제공자로 전환하지 않습니다.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
# v1 또는 사내 리소스에서 지원하는 날짜 기반 API 버전을 지정하세요.
AZURE_OPENAI_API_VERSION=v1
# 모델 식별자와 실제 Azure 배포 이름은 다를 수 있습니다.
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
# 비어 있으면 GPT-5.5 텍스트 배포로 이미지 인식을 수행합니다.
AZURE_OPENAI_CAPTION_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT=480
AZURE_OPENAI_MAX_RETRIES=2

# 별도의 음성 생성 배포가 필요합니다. 예: gpt-4o-mini-tts 배포의 실제 이름
AZURE_OPENAI_TTS_DEPLOYMENT=
AZURE_OPENAI_TTS_VOICE=alloy
# instructions를 지원하는 TTS 배포에서만 설정하세요.
AZURE_OPENAI_TTS_INSTRUCTIONS=
FFMPEG_PATH=ffmpeg
VIDEO_MAX_PAGES=50

IMAGE_QUALITY=auto
TEXT_MAX_OUTPUT_TOKENS=16384
MAX_DESCRIPTION_WORKERS=3
MAX_IMAGE_WORKERS=1
# 웹 설정에서 저장한 디자인 시스템 프롬프트가 우선합니다.
DESIGN_SYSTEM_PROMPT=

DOCUMENT_PARSER=local
DOCUMENT_PARSER_URL=
DOCUMENT_PARSER_TOKEN=
# 명시적으로 구성한 사내 호환 서비스만 사용합니다.
MINERU_API_BASE=
MINERU_TOKEN=
AUTO_IMAGE_CAPTION=false
OCR_PROVIDER=local
OCR_API_URL=
OCR_API_KEY=
OCR_LANGUAGES=kor+eng
TESSERACT_CMD=
INPAINTING_PROVIDER=local
TEXT_STYLE_PROVIDER=local

# HTTPS 인증서 검증은 항상 켜져 있습니다.
# CORPORATE_CA_FILE=C:/certs/company-root-ca.pem
# HTTPS_PROXY=http://proxy.company:8080
# HTTP_PROXY=http://proxy.company:8080
NO_PROXY=localhost,127.0.0.1,::1
