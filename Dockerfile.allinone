# Mirror Source Configuration Parameters (by build args Overwrite）
ARG DOCKER_REGISTRY=
ARG GHCR_REGISTRY=ghcr.io/
ARG NPM_REGISTRY=
ARG APT_MIRROR=
ARG PYPI_INDEX_URL=
ARG APP_VERSION_TAG=
ARG APP_COMMIT_SHA=
ARG APP_COMMIT_SHORT_SHA=
ARG APP_BUILD_DATE=

# ── Stage 1: Build Frontend ──────────────────────────────────────────
FROM ${DOCKER_REGISTRY:-}node:22.23.4-alpine AS frontend-builder

ARG NPM_REGISTRY=
ARG APP_VERSION_TAG=
ARG APP_COMMIT_SHA=
ARG APP_COMMIT_SHORT_SHA=
ARG APP_BUILD_DATE=
ENV VITE_APP_VERSION_TAG=${APP_VERSION_TAG}
ENV VITE_APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV VITE_APP_COMMIT_SHORT_SHA=${APP_COMMIT_SHORT_SHA}
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
COPY frontend/.npmrc ./
COPY scripts/check-node.cjs /scripts/check-node.cjs
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    if [ -n "$NPM_REGISTRY" ]; then \
        npm config set registry "$NPM_REGISTRY"; \
    fi && \
    npm ci

COPY frontend/ ./
RUN npm run build:web

# ── Stage 2: Access uv ──────────────────────────────────────────
FROM ${GHCR_REGISTRY}astral-sh/uv:latest AS uv

# ── Stage 3: Final One Mirror ──────────────────────────────────────
FROM ${DOCKER_REGISTRY:-}python:3.10-slim

ARG APT_MIRROR=
ARG PYPI_INDEX_URL=
ARG APP_VERSION_TAG=
ARG APP_COMMIT_SHA=
ARG APP_COMMIT_SHORT_SHA=
ARG APP_BUILD_DATE=

WORKDIR /app

# System Dependence for Installation：nginx + supervisor + curl + ffmpeg
RUN if [ -n "$APT_MIRROR" ]; then \
        if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
            sed -i "s@deb.debian.org@$APT_MIRROR@g" /etc/apt/sources.list.d/debian.sources; \
        fi; \
    fi && \
    apt-get update && apt-get install -y \
        curl \
        ffmpeg \
        fonts-noto-cjk \
        nginx \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy uv
COPY --from=uv /uv /usr/local/bin/uv
RUN chmod +x /usr/local/bin/uv

# Install Python Dependency
COPY pyproject.toml uv.lock* ./
ENV UV_INDEX_URL=${PYPI_INDEX_URL}
ENV UV_HTTP_TIMEOUT=300
RUN if [ -f uv.lock ]; then uv sync --frozen; else uv sync; fi

# Copy backend codes and resources
COPY backend/ ./backend/
COPY assets/ ./assets/
COPY docker/ ./docker/

# Copy front-end builder
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Configuration nginx
COPY docker/nginx-allinone.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# Start Script Executable
RUN chmod +x /app/docker/start-backend.sh

# Create the necessary directory
RUN mkdir -p /app/backend/instance /app/uploads

ENV PYTHONPATH=/app
ENV FLASK_APP=backend/app.py
ENV IN_DOCKER=1
ENV APP_VERSION_TAG=${APP_VERSION_TAG}
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV APP_COMMIT_SHORT_SHA=${APP_COMMIT_SHORT_SHA}
ENV APP_BUILD_DATE=${APP_BUILD_DATE}
ENV DOCKERHUB_REPOSITORY=banana-slides

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["/usr/bin/supervisord", "-c", "/app/docker/supervisord.conf"]
