# syntax=docker/dockerfile:1
FROM node:22.23.4-bookworm-slim AS frontend-builder
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
COPY scripts/check-node.cjs /src/scripts/check-node.cjs
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; npm ci
COPY frontend/ ./
RUN npm run build:web
FROM golang:1.27.3-alpine AS go-builder
WORKDIR /src/backend
COPY backend/ ./
RUN --mount=type=secret,id=proxy_ca --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sola-server ./cmd/sola-server
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tesseract-ocr tesseract-ocr-eng tesseract-ocr-kor \
    ffmpeg poppler-utils libreoffice-impress fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home sola \
    && mkdir -p /data /app && chown -R 10001:10001 /data /app
COPY --from=go-builder /out/sola-server /usr/local/bin/sola-server
COPY LICENSE /usr/share/doc/sola/LICENSE
LABEL org.opencontainers.image.source="https://github.com/Jungwoo-Ryu/banana-slides" org.opencontainers.image.licenses="AGPL-3.0"
ENV SOLA_DATA_DIR=/data
WORKDIR /app
USER 10001:10001
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=6s --start-period=10s --retries=3 \
    CMD ["sola-server", "--healthcheck", "http://127.0.0.1:5000/health"]
ENTRYPOINT ["sola-server"]
COPY --from=frontend-builder --chown=10001:10001 /src/frontend/dist /app/frontend
CMD ["--listen", "0.0.0.0:5000", "--allow-network", "--no-auth", "--web-dir", "/app/frontend"]
